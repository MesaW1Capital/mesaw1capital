<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Painel de Preços · Bisoprolol</title>
<style>
  /* Fonte oficial da Merck: coloque o arquivo licenciado em fonts/Merck.woff2
   e os títulos passam a usá-la automaticamente. Sem o arquivo, usa o fallback. */
@font-face{font-family:"MerckLocal";
  src:url("fonts/Merck.woff2") format("woff2"), url("fonts/Merck.woff") format("woff");
  font-weight:400 900; font-display:swap;}
:root{
    --font-body:Verdana,Geneva,sans-serif;
    --font-titulo:Verdana,Geneva,sans-serif;
    --magenta:#E6007E; --magenta-deep:#B10063; --purple:#5B2A86; --purple-lt:#7B3FB0;
    --blue:#0F69AF; --teal:#008A80; --yellow:#FFC72C;
    --amarelo:#ffe68a; --amarelo-tx:#6b5200; --amarelo-bd:#f0cf6e; --verde:#1f9d6b;
    --ink:#241f2b; --ink-soft:#6a6475; --line:#ececf1; --bg:#ffffff; --soft:#f7f4fa;
    --exemplo:#B26A00; --exemplo-bg:#fff3dd; --exemplo-bd:#f0d59a;
    --radius:18px; --shadow:0 2px 4px rgba(91,42,134,.06),0 14px 34px rgba(91,42,134,.09);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--soft);color:var(--ink);font-family:var(--font-body);line-height:1.5}
  .wrap{max-width:1220px;margin:0 auto;padding:20px 20px 70px}
  a{color:inherit}

  /* Hero */
  header.top{position:relative;overflow:hidden;border-radius:var(--radius);padding:30px 30px 26px;color:#fff;
    background:linear-gradient(120deg,var(--magenta) 0%,var(--purple) 78%);box-shadow:var(--shadow)}
  header.top::before{content:"";position:absolute;right:-60px;top:-80px;width:320px;height:320px;border-radius:50%;
    background:radial-gradient(circle at center,rgba(255,255,255,.16),transparent 60%)}
  header.top::after{content:"";position:absolute;left:-40px;bottom:-120px;width:260px;height:260px;border-radius:50%;
    background:radial-gradient(circle at center,rgba(255,199,44,.18),transparent 62%)}
  .brand{display:flex;align-items:center;gap:12px;position:relative;z-index:1}
  .mmark{font-family:var(--font-titulo);font-weight:800;font-size:20px;letter-spacing:-.02em;
    background:#fff;color:var(--magenta);width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;
    transform:skewX(-6deg)}
  .mlogo{height:40px;width:auto;display:block;filter:drop-shadow(0 2px 6px rgba(0,0,0,.28))}
  .brand span{font-family:var(--font-titulo);font-weight:600;font-size:13px;opacity:.92;letter-spacing:.02em}
  header.top h1{position:relative;z-index:1;font-family:var(--font-titulo);font-weight:800;letter-spacing:-.02em;
    font-size:clamp(24px,4.4vw,38px);margin:16px 0 0;line-height:1.05}
  header.top p.sub{position:relative;z-index:1;margin:10px 0 0;max-width:64ch;font-size:14.5px;color:#fbe9f4}
  .chips{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
  .chip{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:600;
    background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.26);color:#fff;padding:6px 12px;border-radius:999px}
  .chip b{font-family:Verdana,sans-serif}
  .chip .dot{width:8px;height:8px;border-radius:50%;background:var(--yellow)}

  /* Aviso */
  .aviso{display:flex;gap:12px;align-items:flex-start;margin-top:16px;background:var(--exemplo-bg);
    border:1px solid var(--exemplo-bd);border-radius:14px;padding:14px 16px}
  .aviso .ic{font-size:18px;line-height:1.2}
  .aviso p{margin:0;font-size:13px;color:#5b4413}
  .aviso b{color:#7a5a12}

  /* Anatomia */
  .concept{margin-top:18px;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);
    box-shadow:var(--shadow);padding:22px 24px;display:grid;grid-template-columns:minmax(230px,300px) 1fr;gap:28px;align-items:center}
  .eyebrow{font-family:Verdana,sans-serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--magenta);margin:0 0 6px;font-weight:600}
  .concept h2{font-family:var(--font-titulo);font-weight:700;font-size:18px;margin:0 0 6px}
  .concept .lead{color:var(--ink-soft);font-size:13.5px;margin:0 0 14px}
  .ticket{border:1px solid var(--line);border-radius:14px;padding:16px 18px;background:linear-gradient(160deg,#fff,#fdf4fa)}
  .ticket .prod{font-family:var(--font-titulo);font-weight:700;font-size:15px}
  .ticket .meta{font-size:11.5px;color:var(--ink-soft);margin-bottom:12px}
  .ticket .cheio{font-family:Verdana,sans-serif;color:#9b93a6;text-decoration:line-through;text-decoration-thickness:1.6px;font-size:15px}
  .ticket .row2{display:flex;align-items:baseline;gap:10px;margin-top:2px}
  .ticket .com{font-family:Verdana,sans-serif;font-weight:600;font-size:28px;color:var(--magenta);letter-spacing:-.02em}
  .badge{font-family:Verdana,sans-serif;font-weight:600;font-size:12px;color:var(--amarelo-tx);background:var(--amarelo);border:1px solid var(--amarelo-bd);padding:2px 9px;border-radius:999px}
  .legend{display:grid;gap:12px}
  .legend .item{display:grid;grid-template-columns:28px 1fr;gap:12px;align-items:start}
  .legend .num{font-family:var(--font-titulo);font-weight:700;font-size:12px;color:#fff;border-radius:9px;height:28px;display:flex;align-items:center;justify-content:center}
  .legend .item:nth-child(1) .num{background:var(--magenta)}
  .legend .item:nth-child(2) .num{background:#D99A00}
  .legend .item:nth-child(3) .num{background:var(--purple)}
  .legend .t{font-weight:700;font-size:13.5px;font-family:var(--font-titulo)}
  .legend .d{font-size:12.5px;color:var(--ink-soft)}

  /* Controles */
  .controls{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin:26px 0 12px}
  .tabs{display:inline-flex;background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:4px;box-shadow:var(--shadow)}
  .tabs button{font-family:var(--font-titulo);font-weight:600;font-size:13px;color:var(--ink-soft);border:0;background:transparent;padding:9px 18px;border-radius:999px;cursor:pointer;transition:.15s}
  .tabs button[aria-selected="true"]{background:linear-gradient(120deg,var(--magenta),var(--purple-lt));color:#fff}
  .rightctl{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .search{position:relative}
  .search input{font-size:13px;border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:10px 14px 10px 34px;width:230px;max-width:52vw;color:var(--ink);box-shadow:var(--shadow)}
  .search input:focus{outline:2px solid var(--magenta);outline-offset:1px}
  .search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--ink-soft)}
  .sugestoes{position:absolute;top:calc(100% + 6px);left:0;right:0;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);z-index:30;max-height:280px;overflow:auto;padding:6px}
  .sugestoes[hidden]{display:none}
  .sugestoes .sug{padding:9px 10px;border-radius:8px;font-size:13px;cursor:pointer;display:flex;align-items:center;gap:8px}
  .sugestoes .sug:hover{background:#fbf0f7}
  .sugestoes .sug .nome{font-family:var(--font-titulo);font-weight:600}
  .sugestoes .sug .tipo{margin-left:auto;font-size:10px;color:var(--ink-soft);border:1px solid var(--line);border-radius:999px;padding:1px 7px}
  .upload{font-family:var(--font-titulo);font-weight:600;font-size:13px;color:#fff;background:var(--purple);border-radius:999px;padding:10px 16px;cursor:pointer;box-shadow:var(--shadow);white-space:nowrap;transition:.15s}
  .upload:hover{background:var(--purple-lt)}

  /* Tabela */
  .tablecard{background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
  .scroll{overflow-x:auto}
  table{border-collapse:separate;border-spacing:0;width:100%;min-width:960px}
  thead th{position:sticky;top:0;z-index:3;background:var(--purple);color:#fff;font-family:var(--font-titulo);font-weight:600;font-size:12.5px;text-align:center;padding:13px 10px;white-space:nowrap}
  thead th.prodcol{text-align:center;left:0;z-index:5}
  th.prodcol,td.prodcol{position:sticky;left:0;background:var(--bg);z-index:2;text-align:center;min-width:215px;box-shadow:1px 0 0 var(--line)}
  thead th.prodcol{background:var(--purple)}
  tbody td{border-bottom:1px solid var(--line);padding:10px;text-align:center;vertical-align:middle}
  tbody tr:hover td,tbody tr:hover td.prodcol{background:#fbf7fd}
  .pname{font-family:var(--font-titulo);font-weight:600;font-size:13.5px}
  .plab{font-size:11.5px;color:var(--ink-soft)}
  .plab .tag{display:inline-block;font-family:Verdana,sans-serif;font-size:10px;border:1px solid var(--line);border-radius:6px;padding:0 5px;margin-left:6px;color:var(--purple)}
  tbody tr.grouprow td{background:linear-gradient(90deg,#f3e9fb,#fdeef6);padding:9px 12px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  tbody tr.grouprow td.gcell{position:sticky;left:0;z-index:2;background:#f3e9fb;font-family:var(--font-titulo);font-weight:700;font-size:13px;color:var(--purple);box-shadow:1px 0 0 var(--line);text-align:center}
  tbody tr.grouprow td.gspan{text-align:center}
  .glabel{font-family:Verdana,sans-serif;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--magenta)}

  .cell{display:inline-flex;flex-direction:column;align-items:center;gap:1px;min-width:92px;position:relative}
  .cell .c-cheio{font-family:Verdana,sans-serif;font-size:11.5px;color:#a49bb0;text-decoration:line-through;text-decoration-thickness:1.4px;min-height:14px}
  .cell .c-com{font-family:Verdana,sans-serif;font-weight:600;font-size:15.5px;color:var(--ink)}
  .cell .c-badge{font-family:Verdana,sans-serif;font-weight:600;font-size:10.5px;color:var(--amarelo-tx);background:var(--amarelo);border:1px solid var(--amarelo-bd);padding:1px 6px;border-radius:999px;margin-top:2px}
  .cell .c-tag{font-family:Verdana,sans-serif;font-size:9px;letter-spacing:.06em;padding:0 5px;border-radius:999px;margin-top:3px}
  .cell.real .c-com{color:var(--magenta)}
  .cell.real .c-tag{color:#fff;background:var(--verde)}
  .cell.exemplo .c-tag{color:var(--exemplo);background:var(--exemplo-bg);border:1px solid var(--exemplo-bd)}

  /* Reais coletados */
  .reais{margin-top:26px;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
  .reais .rhead{background:linear-gradient(120deg,var(--verde),#0f69af);color:#fff;padding:16px 22px}
  .reais .rhead h2{font-family:var(--font-titulo);font-weight:700;font-size:16px;margin:0}
  .reais .rhead p{margin:4px 0 0;font-size:12.5px;color:#e6fbf7}
  .reais table{min-width:640px}
  .reais thead th{background:#0c6f66;font-size:12px;padding:10px}
  .reais thead th:first-child{text-align:left;padding-left:22px}
  .reais tbody td{font-size:13px;text-align:center}
  .reais tbody td:first-child{text-align:left;padding-left:22px}
  .reais .rprod{font-family:var(--font-titulo);font-weight:600}
  .reais .rcheio{font-family:Verdana,sans-serif;color:#9b93a6;text-decoration:line-through}
  .reais .rcom{font-family:Verdana,sans-serif;font-weight:600;color:var(--magenta)}
  .reais .rfonte{font-size:11.5px;color:var(--ink-soft);text-align:left}

  footer.legal{margin-top:24px;font-size:11.5px;color:#8a8393;text-align:center;line-height:1.6}
  @media (max-width:720px){.concept{grid-template-columns:1fr}.wrap{padding:14px 12px 48px}}
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <div class="brand"><img class="mlogo" src="data:image/png;base64," alt="Merck"><span>Inteligência de Preços · Bisoprolol</span></div>
    <h1>Painel de Preços — Bisoprolol</h1>
    <p class="sub">Preço cheio × preço com desconto por farmácia. Cada célula reúne três informações: preço cheio, percentual de desconto e preço final praticado.</p>
    <div class="chips">
      <span class="chip"><span class="dot"></span> CEP de referência: <b>São Paulo/SP</b></span>
      <span class="chip">Coleta em <b>21/07/2026</b></span>
      <span class="chip" id="chipFonte">Grade em modo Exemplo</span>
    </div>
  </header>

  <div class="aviso">
    <div class="ic">⚠️</div>
    <p><b>Leia antes:</b> a grade dos 6 sites abaixo está preenchida com <b>valores de EXEMPLO</b> (marcados com a etiqueta <b>Exemplo</b>), apenas para visualizar o layout — eles se baseiam em faixas reais de mercado, mas não são o preço oficial de cada site. Os <b>preços reais que coletei hoje</b> estão no bloco verde <b>“Preços reais coletados”</b>, mais abaixo. Quando o robô rodar, ele substitui a grade pelos preços reais por site (CEP de SP).</p>
  </div>

  <section class="concept">
    <div>
      <p class="eyebrow">Anatomia de um preço</p>
      <div class="ticket">
        <div class="prod">Concor 5mg</div>
        <div class="meta">Merck · 30 comp. · Droga Raia (CEP SP) — preço real</div>
        <div class="cheio">R$ 113,21</div>
        <div class="row2"><span class="com">R$ 92,99</span><span class="badge">−18%</span></div>
      </div>
    </div>
    <div>
      <p class="eyebrow">Como ler cada célula</p>
      <h2>Preço cheio × preço com desconto</h2>
      <p class="lead">O valor em destaque já é o preço com desconto — mas ele parte de um preço cheio, e a diferença entre os dois é o desconto. O painel registra os três.</p>
      <div class="legend">
        <div class="item"><div class="num">1</div><div><div class="t">Preço cheio</div><div class="d">Valor de tabela, mostrado riscado. É a base de onde parte o desconto.</div></div></div>
        <div class="item"><div class="num">2</div><div><div class="t">Desconto</div><div class="d">Percentual de redução — calculado a partir do preço cheio.</div></div></div>
        <div class="item"><div class="num">3</div><div><div class="t">Preço com desconto</div><div class="d">O que o cliente paga de fato. É o número em destaque, em magenta.</div></div></div>
      </div>
    </div>
  </section>

  <div class="controls">
    <div class="tabs" role="tablist">
      <button role="tab" aria-selected="true" data-tab="marcas">Marcas (referência)</button>
      <button role="tab" aria-selected="false" data-tab="genericos">Genéricos</button>
    </div>
    <div class="rightctl">
      <div class="search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="filtro" type="text" placeholder="Filtrar por remédio ou laboratório" autocomplete="off" />
        <div id="sugestoes" class="sugestoes" hidden></div>
      </div>
      <label class="upload">Carregar precos.json<input id="arquivo" type="file" accept=".json,application/json" hidden /></label>
    </div>
  </div>

  <div class="tablecard">
    <div class="scroll"><table id="tabela"><thead><tr id="cabecalho"></tr></thead><tbody id="corpo"></tbody></table></div>
  </div>

  <!-- Preços reais coletados -->
  <section class="reais">
    <div class="rhead">
      <h2>Preços reais coletados (21/07/2026)</h2>
      <p>Valores verdadeiros obtidos de fontes públicas. Alguns são referência de mercado de outra rede (fonte indicada). Preços variam por CEP, loja e dia.</p>
    </div>
    <div class="scroll"><table><thead><tr>
      <th>Produto</th><th>Lab.</th><th>Apres.</th><th>Cheio</th><th>Com desconto</th><th>Fonte</th>
    </tr></thead><tbody id="corpoReais"></tbody></table></div>
  </section>

  <footer class="legal">
    Painel interno de acompanhamento de preços. Valores de "exemplo" são ilustrativos; valores "reais" refletem a data/fonte indicada e variam por CEP, loja e dia.<br>
    Ferramenta de trabalho — não é recomendação de compra ou uso de medicamento. Identidade visual inspirada na marca Merck.
  </footer>
</div>

<script>
const SITES = ["Drogasil","Pague Menos","DPSP","Araújo","Nova Esperança","Consulta Remédios"];

const MARCAS = [
  ["Concor 1,25mg","Merck"],["Concor 2,5mg","Merck"],["Concor 5mg","Merck"],["Concor 10mg","Merck"],
  ["Concardio 1,25mg","EMS"],["Concardio 2,5mg","EMS"],["Concardio 5mg","EMS"],["Concardio 10mg","EMS"],
  ["Iccor 1,25mg","Torrent"],["Iccor 2,5mg","Torrent"],["Iccor 5mg","Torrent"],["Iccor 10mg","Torrent"],
  ["Bizo 2,5mg","Eurofarma"],["Bizo 5mg","Eurofarma"],["Bizo 10mg","Eurofarma"],
  ["Laio 1,25mg","Farmoquímica"],["Laio 2,5mg","Farmoquímica"],["Laio 5mg","Farmoquímica"],["Laio 10mg","Farmoquímica"],
];
const GENERICOS = [];
["Merck","Neo Química","EMS","Pharlab","Torrent"].forEach(lab=>["1,25mg","2,5mg","5mg","10mg"].forEach(d=>GENERICOS.push([`Hemifumarato de Bisoprolol ${d}`,lab])));
["2,5mg","5mg","10mg"].forEach(d=>GENERICOS.push([`Hemifumarato de Bisoprolol ${d}`,"Medley"]));

/* baseline (ancorado em preços reais coletados; senão estimativa) */
const BASE = {
  "Concor 1,25mg":[79.90,69.90],"Concor 2,5mg":[84.90,73.90],"Concor 5mg":[113.21,92.99],"Concor 10mg":[132.85,116.90],
  "Concardio 1,25mg":[46.90,39.90],"Concardio 2,5mg":[58.90,49.90],"Concardio 5mg":[85.05,74.84],"Concardio 10mg":[96.90,83.90],
  "Iccor 1,25mg":[59.33,49.90],"Iccor 2,5mg":[65.12,55.90],"Iccor 5mg":[75.76,66.67],"Iccor 10mg":[89.90,78.90],
  "Bizo 2,5mg":[57.91,49.90],"Bizo 5mg":[67.36,59.28],"Bizo 10mg":[78.90,68.90],
  "Laio 1,25mg":[49.90,43.90],"Laio 2,5mg":[58.44,50.90],"Laio 5mg":[69.90,60.90],"Laio 10mg":[81.90,71.90],
};
function baseGenerico(nome){
  const d = nome.match(/(\d+,\d+|\d+)mg/)[1];
  const t = {"1,25":[32.90,27.90],"2,5":[38.90,32.90],"5":[42.90,35.90],"10":[52.90,44.90]}[d] || [39.90,33.90];
  return t;
}

/* dados reais coletados hoje */
const REAIS = [
  ["Concor 5mg","Merck","30 comp.",113.21,92.99,"Droga Raia (CEP SP) — do print enviado"],
  ["Concor 5mg","Merck","30 comp.",111.84,98.42,"Farmácias São João"],
  ["Concor 5mg","Merck","30 comp.",90.49,null,"Drogasil (preço base do site, sem CEP)"],
  ["Concardio 5mg","EMS","30 comp.",85.05,74.84,"Farmácias São João"],
  ["Iccor 5mg","Torrent","30 comp.",75.76,66.67,"Farmácias São João"],
  ["Iccor 2,5mg","Torrent","30 comp.",65.12,null,"Drogaria Minas Brasil"],
  ["Iccor 1,25mg","Torrent","30 comp.",59.33,49.90,"Drogaria Minas Brasil"],
  ["Bizo 5mg","Eurofarma","30 comp.",67.36,59.28,"Farmácias São João"],
  ["Bizo 2,5mg","Eurofarma","30 comp.",57.91,null,"Drogaria Minas Brasil"],
  ["Laio 2,5mg","Farmoquímica","30 comp.",58.44,null,"Drogaria Minas Brasil"],
  ["Iccor 2,5mg","Torrent","100 comp.",157.00,null,"DPSP / Drogaria São Paulo"],
];

/* gera a grade de exemplo (variação leve por site) + 1 célula real */
const DATA = {};
function gerar(){
  const linhas = MARCAS.concat(GENERICOS);
  linhas.forEach(([nome,lab])=>{
    const b = BASE[nome] || baseGenerico(nome);
    SITES.forEach((site,i)=>{
      const f = 1 + (i-2.5)*0.016;
      const cheio = Math.round(b[0]*f*100)/100;
      const com   = Math.round(b[1]*f*100)/100;
      DATA[`${nome}|${lab}|${site}`] = {cheio, com, tipo:"exemplo", fonte:"Exemplo (ilustrativo)"};
    });
  });
  // única célula real na grade:
  DATA["Concor 5mg|Merck|Drogasil"] = {com:90.49, base:true, tipo:"real", fonte:"Drogasil — preço base do site (sem CEP)"};
}
gerar();

const brl = n => n==null ? "—" : n.toLocaleString("pt-BR",{style:"currency",currency:"BRL"});

function cellHTML(prod,lab,site){
  const d = DATA[`${prod}|${lab}|${site}`];
  if(!d || (d.com==null && d.cheio==null)) return `<span style="color:#c9c2d2;font-family:Verdana,sans-serif;font-size:12px">—</span>`;
  const title = d.fonte ? ` title="${d.fonte.replace(/"/g,'&quot;')}"` : "";
  if(d.base){
    return `<span class="cell real"${title}><span class="c-cheio" style="visibility:hidden">.</span><span class="c-com">${brl(d.com)}</span><span class="c-tag">Real · base</span></span>`;
  }
  let cheio=`<span class="c-cheio" style="visibility:hidden">.</span>`, badge="";
  if(d.cheio!=null && d.cheio>d.com){
    cheio=`<span class="c-cheio">${brl(d.cheio)}</span>`;
    const pct=Math.round((1-d.com/d.cheio)*100);
    if(pct>0) badge=`<span class="c-badge">−${pct}%</span>`;
  }
  const tag = d.tipo==="real" ? `<span class="c-tag">Real</span>` : `<span class="c-tag">Exemplo</span>`;
  const cls = d.tipo==="real" ? "cell real" : "cell exemplo";
  return `<span class="${cls}"${title}>${cheio}<span class="c-com">${brl(d.com)}</span>${badge}${tag}</span>`;
}

function buildHeader(){
  document.getElementById("cabecalho").innerHTML =
    `<th class="prodcol">Produto</th>`+SITES.map(s=>`<th>${s}</th>`).join("");
}
let currentRows = MARCAS;
const groupOf = (rows,nome,lab)=> rows===GENERICOS ? lab : nome.split(" ")[0];
function buildBody(rows,filter=""){
  const f=filter.trim().toLowerCase();
  const body=document.getElementById("corpo");
  const filtered=rows.filter(([n,l])=>!f||n.toLowerCase().includes(f)||l.toLowerCase().includes(f));
  if(!filtered.length){body.innerHTML=`<tr><td class="prodcol">—</td><td colspan="${SITES.length}" style="text-align:center;color:#8a8393;padding:22px">Nada encontrado para “${filter}”.</td></tr>`;return;}
  const groupLabel=rows===GENERICOS?"Laboratório":"Marca", tipo=rows===GENERICOS?"Genérico":"Referência";
  let html="",last=null;
  filtered.forEach(([nome,lab])=>{
    const g=groupOf(rows,nome,lab);
    if(g!==last){html+=`<tr class="grouprow"><td class="prodcol gcell">${g}</td><td class="gspan" colspan="${SITES.length}"><span class="glabel">${groupLabel}</span></td></tr>`;last=g;}
    const cells=SITES.map(s=>`<td>${cellHTML(nome,lab,s)}</td>`).join("");
    html+=`<tr><td class="prodcol"><div class="pname">${nome}</div><div class="plab">${lab}<span class="tag">${tipo}</span></div></td>${cells}</tr>`;
  });
  body.innerHTML=html;
}
function buildReais(){
  document.getElementById("corpoReais").innerHTML = REAIS.map(([n,l,a,ch,co,ft])=>{
    const cheio = ch!=null ? `<span class="rcheio">${brl(ch)}</span>` : "—";
    const desc = (ch!=null&&co!=null&&co<ch) ? ` <span style="font-family:Verdana,sans-serif;font-size:11px;color:#B26A00">(−${Math.round((1-co/ch)*100)}%)</span>` : "";
    const com = co!=null ? `<span class="rcom">${brl(co)}</span>${desc}` : "—";
    return `<tr><td class="rprod">${n}</td><td>${l}</td><td>${a}</td><td>${cheio}</td><td>${com}</td><td class="rfonte">${ft}</td></tr>`;
  }).join("");
}

document.querySelectorAll('.tabs button').forEach(btn=>btn.addEventListener('click',()=>{
  document.querySelectorAll('.tabs button').forEach(b=>b.setAttribute('aria-selected','false'));
  btn.setAttribute('aria-selected','true');
  currentRows = btn.dataset.tab==="genericos"?GENERICOS:MARCAS;
  buildBody(currentRows,document.getElementById('filtro').value);
}));
const boxSug = document.getElementById('sugestoes');
const semDose = n => n.replace(/\s*\d+(,\d+)?mg\s*$/,'').trim();
function famsLabs(rows){
  const fam=[], labs=[];
  rows.forEach(([n,l])=>{ const f=semDose(n); if(!fam.includes(f))fam.push(f); if(!labs.includes(l))labs.push(l); });
  return {fam,labs};
}
function renderSug(q){
  const {fam,labs}=famsLabs(currentRows);
  const ql=(q||'').trim().toLowerCase();
  const itens=[];
  fam.forEach(f=>{ if(!ql||f.toLowerCase().includes(ql)) itens.push({t:f,tipo:'Remédio'}); });
  labs.forEach(l=>{ if(!ql||l.toLowerCase().includes(ql)) itens.push({t:l,tipo:'Laboratório'}); });
  if(!itens.length){ boxSug.hidden=true; return; }
  boxSug.innerHTML=itens.slice(0,12).map(i=>`<div class="sug" data-v="${i.t.replace(/"/g,'&quot;')}"><span class="nome">${i.t}</span><span class="tipo">${i.tipo}</span></div>`).join('');
  boxSug.hidden=false;
}
const inputFiltro=document.getElementById('filtro');
inputFiltro.addEventListener('focus',e=>renderSug(e.target.value));
inputFiltro.addEventListener('input',e=>{ renderSug(e.target.value); buildBody(currentRows,e.target.value); });
boxSug.addEventListener('mousedown',e=>{
  const s=e.target.closest('.sug'); if(!s) return; e.preventDefault();
  inputFiltro.value=s.dataset.v; buildBody(currentRows,s.dataset.v); boxSug.hidden=true;
});
document.addEventListener('click',e=>{ if(!e.target.closest('.search')) boxSug.hidden=true; });
document.getElementById('arquivo').addEventListener('change',e=>{
  const file=e.target.files[0]; if(!file) return;
  const rd=new FileReader();
  rd.onload=()=>{try{
    const j=JSON.parse(rd.result); Object.assign(DATA,j);
    const n=Object.keys(j).length;
    document.getElementById('chipFonte').innerHTML='Fonte: precos.json · <b>'+n+' preços</b>';
    buildBody(currentRows,document.getElementById('filtro').value);
  }catch(err){alert('Arquivo inválido: '+err.message);}};
  rd.readAsText(file);
});

buildHeader(); buildBody(currentRows); buildReais();

fetch('precos.json',{cache:'no-store'}).then(r=>r.ok?r.json():null).then(j=>{
  if(!j) return; Object.assign(DATA,j);
  const n=Object.keys(j).length;
  document.getElementById('chipFonte').innerHTML='Fonte: precos.json · <b>'+n+' preços</b>';
  buildBody(currentRows,document.getElementById('filtro').value);
}).catch(()=>{});
</script>
</body>
</html>
